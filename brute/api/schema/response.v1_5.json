{
 "$id": "brute.api/1.5/response",
 "type": "object",
 "required": [
  "api_version",
  "request_id",
  "op",
  "status",
  "reason",
  "certificate",
  "support",
  "probabilities",
  "refusal_text",
  "retractions",
  "evidence",
  "forecast_source",
  "experiment",
  "resumed",
  "alarm_resumes"
 ],
 "additionalProperties": false,
 "properties": {
  "api_version": {
   "const": "brute.api/1.5"
  },
  "request_id": {
   "type": "string"
  },
  "op": {
   "type": [
    "string",
    "null"
   ]
  },
  "status": {
   "enum": [
    "ACKNOWLEDGED",
    "CERTIFIED",
    "POSSIBLE_SET",
    "ABSTAIN",
    "OUT_OF_FAMILY",
    "ERROR"
   ]
  },
  "reason": {
   "enum": [
    null,
    "MARGIN_DISAGREES",
    "BOUND_SATURATED",
    "RESIDUAL_SURPRISE",
    "BUDGET_EXHAUSTED",
    "UNATTESTED_SCOPE",
    "FAMILY_CONTRADICTED",
    "NOT_INITIALIZED",
    "INVALID_REQUEST",
    "INTERNAL",
    "RESYNC_AMBIGUOUS",
    "SOLVER_BUDGET"
   ]
  },
  "certificate": {
   "type": [
    "object",
    "null"
   ],
   "required": [
    "value",
    "kind",
    "conditional_on"
   ],
   "additionalProperties": false,
   "properties": {
    "value": {
     "type": "object",
     "additionalProperties": {
      "type": "integer"
     }
    },
    "kind": {
     "enum": [
      "conditional",
      "public"
     ]
    },
    "conditional_on": {
     "type": "string"
    }
   }
  },
  "support": {
   "type": [
    "array",
    "null"
   ],
   "items": {
    "type": "object",
    "additionalProperties": {
     "type": "integer"
    }
   }
  },
  "probabilities": {
   "type": [
    "array",
    "null"
   ],
   "items": {
    "type": "object",
    "required": [
     "value",
     "p"
    ],
    "properties": {
     "value": {
      "type": "object"
     },
     "p": {
      "type": "number"
     }
    }
   }
  },
  "refusal_text": {
   "type": [
    "string",
    "null"
   ]
  },
  "retractions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "step",
     "previous_value",
     "reason"
    ],
    "properties": {
     "step": {
      "type": "integer"
     },
     "previous_value": {
      "type": "object"
     },
     "reason": {
      "enum": [
       "falsified_by_observation",
       "scope_withdrawn",
       "unverifiable_masked"
      ]
     }
    },
    "additionalProperties": false
   }
  },
  "evidence": {
   "type": [
    "object",
    "null"
   ],
   "required": [
    "step",
    "family_scope",
    "surviving_rows",
    "margin",
    "saturated",
    "residual",
    "legacy_family_alive",
    "attestation_id",
    "evidence_count",
    "source_sha256",
    "backend",
    "solver_unknown"
   ],
   "properties": {
    "step": {
     "type": "integer"
    },
    "family_scope": {
     "type": "string"
    },
    "surviving_rows": {
     "type": [
      "integer",
      "null"
     ],
     "description": "null in 1.5: the SAT region backend does not enumerate rows"
    },
    "margin": {
     "type": "object",
     "required": [
      "states",
      "agrees",
      "support_size"
     ],
     "properties": {
      "states": {
       "type": "integer"
      },
      "agrees": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "support_size": {
       "type": [
        "integer",
        "null"
       ]
      }
     }
    },
    "saturated": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "residual": {
     "type": "object",
     "required": [
      "window",
      "surprise",
      "threshold",
      "alarm"
     ],
     "properties": {
      "window": {
       "type": "integer"
      },
      "surprise": {
       "type": [
        "number",
        "null"
       ]
      },
      "threshold": {
       "type": [
        "number",
        "null"
       ]
      },
      "alarm": {
       "type": "boolean"
      }
     }
    },
    "legacy_family_alive": {
     "type": "boolean"
    },
    "attestation_id": {
     "type": [
      "string",
      "null"
     ]
    },
    "evidence_count": {
     "type": "integer"
    },
    "source_sha256": {
     "type": "string"
    },
    "backend": {
     "const": "sat-region"
    },
    "solver_unknown": {
     "type": [
      "integer",
      "null"
     ],
     "description": "predict: SAT answers that hit the conflict budget (UNKNOWN) and were used to build this forecast; null for other ops"
    }
   }
  },
  "forecast_source": {
   "enum": [
    null,
    "v090",
    "margin_n5",
    "suffix1",
    "window_n4",
    "uniform"
   ]
  },
  "experiment": {
   "type": [
    "object",
    "null"
   ],
   "required": [
    "action",
    "score",
    "scores",
    "rule",
    "tie_break",
    "tied",
    "check",
    "proposal",
    "no_proposal_reason",
    "policy",
    "volumes"
   ],
   "additionalProperties": false,
   "properties": {
    "action": {
     "type": "string"
    },
    "score": {
     "type": "number"
    },
    "scores": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "action",
       "score"
      ],
      "additionalProperties": false,
      "properties": {
       "action": {
        "type": "string"
       },
       "score": {
        "type": "number"
       }
      }
     }
    },
    "rule": {
     "type": "string"
    },
    "tie_break": {
     "type": "string"
    },
    "tied": {
     "type": "boolean"
    },
    "per_action": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "action",
       "counts"
      ],
      "additionalProperties": false,
      "properties": {
       "action": {
        "type": "string"
       },
       "counts": {
        "type": [
         "object",
         "null"
        ],
        "required": [
         "family_code_rows",
         "family_open_rows",
         "family_rows",
         "margin_rows"
        ],
        "additionalProperties": false,
        "properties": {
         "family_code_rows": {
          "type": "array",
          "items": {
           "type": "object",
           "required": [
            "value",
            "rows"
           ],
           "additionalProperties": false,
           "properties": {
            "value": {
             "type": "object"
            },
            "rows": {
             "type": "integer"
            }
           }
          }
         },
         "family_open_rows": {
          "type": "integer"
         },
         "family_rows": {
          "type": "integer"
         },
         "margin_rows": {
          "type": [
           "integer",
           "null"
          ]
         }
        }
       }
      }
     }
    },
    "check": {
     "type": "boolean"
    },
    "proposal": {
     "enum": [
      "PROPOSED",
      "NO_PROPOSAL"
     ]
    },
    "no_proposal_reason": {
     "enum": [
      null,
      "OUT_OF_SCOPE",
      "RESIDUAL_ALARM"
     ]
    },
    "policy": {
     "enum": [
      "LU-R",
      "M"
     ]
    },
    "volumes": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "type": "number"
     },
     "description": "M policy: per-action expected log2 region-volume proxy, only when the LU-R scores tie"
    }
   }
  },
  "resumed": {
   "type": [
    "boolean",
    "null"
   ],
   "description": "predict only: true when the residual alarm was set earlier in this session and has cleared (certificates are conditional only after any alarm); null for other ops"
  },
  "alarm_resumes": {
   "type": [
    "integer",
    "null"
   ],
   "minimum": 0,
   "description": "predict only: number of times the alarm cleared in this session; null for other ops"
  }
 }
}
