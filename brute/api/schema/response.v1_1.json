{
  "$id": "brute.api/1.1/response",
  "type": "object",
  "required": [
    "api_version",
    "request_id",
    "op",
    "status",
    "reason",
    "certificate",
    "support",
    "probabilities",
    "refusal_text",
    "retractions",
    "evidence",
    "forecast_source"
  ],
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "brute.api/1.1"
    },
    "request_id": {
      "type": "string"
    },
    "op": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "ACKNOWLEDGED",
        "CERTIFIED",
        "POSSIBLE_SET",
        "ABSTAIN",
        "OUT_OF_FAMILY",
        "ERROR"
      ]
    },
    "reason": {
      "enum": [
        null,
        "MARGIN_DISAGREES",
        "BOUND_SATURATED",
        "RESIDUAL_SURPRISE",
        "BUDGET_EXHAUSTED",
        "UNATTESTED_SCOPE",
        "FAMILY_CONTRADICTED",
        "NOT_INITIALIZED",
        "INVALID_REQUEST",
        "INTERNAL"
      ]
    },
    "certificate": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "value",
        "kind",
        "conditional_on"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "kind": {
          "enum": [
            "conditional",
            "public"
          ]
        },
        "conditional_on": {
          "type": "string"
        }
      }
    },
    "support": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": {
          "type": "integer"
        }
      }
    },
    "probabilities": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "value",
          "p"
        ],
        "properties": {
          "value": {
            "type": "object"
          },
          "p": {
            "type": "number"
          }
        }
      }
    },
    "refusal_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "retractions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step",
          "previous_value",
          "reason"
        ],
        "properties": {
          "step": {
            "type": "integer"
          },
          "previous_value": {
            "type": "object"
          },
          "reason": {
            "enum": [
              "falsified_by_observation",
              "scope_withdrawn",
              "unverifiable_masked"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "step",
        "family_scope",
        "surviving_rows",
        "margin",
        "saturated",
        "residual",
        "legacy_family_alive",
        "attestation_id",
        "evidence_count",
        "source_sha256"
      ],
      "properties": {
        "step": {
          "type": "integer"
        },
        "family_scope": {
          "type": "string"
        },
        "surviving_rows": {
          "type": "integer"
        },
        "margin": {
          "type": "object",
          "required": [
            "states",
            "agrees",
            "support_size"
          ],
          "properties": {
            "states": {
              "type": "integer"
            },
            "agrees": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "support_size": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "saturated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "residual": {
          "type": "object",
          "required": [
            "window",
            "surprise",
            "threshold",
            "alarm"
          ],
          "properties": {
            "window": {
              "type": "integer"
            },
            "surprise": {
              "type": [
                "number",
                "null"
              ]
            },
            "threshold": {
              "type": [
                "number",
                "null"
              ]
            },
            "alarm": {
              "type": "boolean"
            }
          }
        },
        "legacy_family_alive": {
          "type": "boolean"
        },
        "attestation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_count": {
          "type": "integer"
        },
        "source_sha256": {
          "type": "string"
        }
      }
    },
    "forecast_source": {
      "enum": [
        null,
        "v090",
        "margin_n5",
        "suffix1",
        "uniform"
      ]
    }
  }
}
