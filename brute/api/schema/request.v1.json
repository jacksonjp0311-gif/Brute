{
  "$id": "brute.api/1.0/request",
  "type": "object",
  "required": ["api_version", "session_id", "op"],
  "additionalProperties": false,
  "properties": {
    "api_version": {"const": "brute.api/1.0"},
    "request_id": {"type": "string"},
    "session_id": {"type": "string"},
    "op": {"enum": ["initialize", "observe", "predict", "retry", "snapshot"]},
    "action": {"type": "string", "description": "symbol from Alphabet.actions"},
    "observation": {"type": "object", "additionalProperties": {"type": ["integer", "null"]},
                    "description": "channel name -> 0/1, or null when masked"},
    "public": {"type": "boolean", "description": "predict: request a public certificate (needs attestation)"},
    "family": {"type": "object", "additionalProperties": false, "properties": {
        "max_states": {"type": "integer", "minimum": 1, "maximum": 5},
        "max_prefixes": {"type": "integer", "minimum": 4}}},
    "attestation": {"type": "object", "required": ["family", "issuer", "basis"], "additionalProperties": false,
                    "properties": {"family": {"type": "string"}, "issuer": {"type": "string"}, "basis": {"type": "string"}}}
  }
}
